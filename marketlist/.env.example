DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=grocery_app
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
PORT=3000
NODE_ENV=development

# Comma-separated browser origins allowed for credentialed CORS (API + Socket.IO).
# Leave unset to use defaults (marketlist.kecktech.net + localhost:3000/3001).
# CORS_ORIGINS=https://marketlist.kecktech.net,http://localhost:3001

# Force Secure cookies in non-production (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=true

# Optional error reporting — SDKs no-op when unset
# API: SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
# Mobile: EXPO_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID
# Web (Next): NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@o0.ingest.sentry.io/PROJECT_ID

# Public web URL used in password-reset emails
# APP_PUBLIC_URL=https://marketlist.kecktech.net

# Optional SMTP for password reset (if unset, non-prod logs the link to the API console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Marketlist <noreply@marketlist.app>

# Required in production — encrypts FarmBot API tokens at rest (64-char hex or any long passphrase)
# TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Break-glass URL for FarmBot map/sequence authoring (not primary Marketlist robot UX)
# FARMBOT_PUBLIC_URL=https://farmbot.kecktech.net
# NEXT_PUBLIC_FARMBOT_PUBLIC_URL=https://farmbot.kecktech.net
# EXPO_PUBLIC_FARMBOT_PUBLIC_URL=https://farmbot.kecktech.net

# Browser uses same-origin /api via Next rewrites in demo/tunnel mode
NEXT_PUBLIC_API_URL=/api
API_PROXY_ORIGIN=http://localhost:3000
# Mobile against VM / LAN
# EXPO_PUBLIC_API_URL=https://marketlist.kecktech.net/api

# API integration tests (optional; default CI sets RUN_INTEGRATION=1 with Postgres)
# RUN_INTEGRATION=1
