---
interface Props {
  name: string;
  description: string;
  href: string;
  image: string;
  color?: string;
  contactEmail?: string;
  demoUser?: string;
  demoPassword?: string;
}
const {
  name,
  description,
  href,
  image,
  color = '#1B6B93',
  contactEmail,
  demoUser,
  demoPassword,
} = Astro.props;
---

<article class="demo-card" style={`--accent: ${color}`}>
  <a class="demo-media" href={href} target="_blank" rel="noopener noreferrer">
    <img src={image} alt="" loading="lazy" width="640" height="400" />
  </a>
  <div class="demo-body">
    <h3 class="demo-heading">
      <a href={href} target="_blank" rel="noopener noreferrer">{name}</a>
    </h3>
    <p class="demo-desc">{description}</p>
    {demoUser && (
      <div class="demo-creds">
        <div class="demo-creds-label">Demo login</div>
        <code>{demoUser}</code>
        {demoPassword && <code>{demoPassword}</code>}
      </div>
    )}
    {contactEmail && (
      <p class="demo-email">
        Contact: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
    )}
    <a class="demo-link" href={href} target="_blank" rel="noopener noreferrer">Open Demo →</a>
  </div>
</article>

<style>
.demo-card {
  background: var(--white);
  border-radius: 10px;
  box-shadow: 0 2px 16px rgba(30, 58, 95, 0.08);
  border-top: 4px solid var(--accent);
  display: flex;
  flex-direction: column;
  color: inherit;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
  height: 100%;
}
.demo-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(30, 58, 95, 0.14);
}
.demo-media {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--off-white);
  display: block;
}
.demo-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}
.demo-card:hover .demo-media img {
  transform: scale(1.04);
}
.demo-body {
  padding: 24px 28px 28px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}
.demo-heading {
  color: var(--navy);
  font-size: 20px;
  margin: 0;
  line-height: 1.3;
}
.demo-heading a {
  color: inherit;
  text-decoration: none;
}
.demo-card:hover .demo-heading a {
  color: var(--ocean);
}
.demo-desc {
  color: var(--charcoal);
  font-size: 15px;
  line-height: 1.7;
  margin: 0;
  flex: 1;
}
.demo-email {
  margin: 0;
  font-size: 13px;
  color: var(--charcoal);
}
.demo-email a {
  color: var(--ocean);
  text-decoration: none;
  font-weight: 600;
}
.demo-email a:hover {
  text-decoration: underline;
}
.demo-creds {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 10px 12px;
  background: var(--off-white);
  border: 1px solid rgba(30, 58, 95, 0.12);
  border-radius: 8px;
}
.demo-creds-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--ocean);
}
.demo-creds code {
  font-size: 12px;
  color: var(--navy);
  word-break: break-all;
}
.demo-link {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 600;
  color: var(--accent);
  margin-top: 4px;
  text-decoration: none;
}
</style>
