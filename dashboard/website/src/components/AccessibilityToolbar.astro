<div class="a11y-toolbar">
  <button
    type="button"
    class="a11y-trigger"
    id="a11y-trigger"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Accessibility options"
  >
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <path stroke-linecap="round" d="M12 3v3M12 18v3M3 12h3M18 12h3"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
    <span class="a11y-trigger-label">A11y</span>
  </button>

  <div class="a11y-panel" id="a11y-panel" hidden>
    <p class="a11y-panel-title">Accessibility</p>

    <label class="a11y-option">
      <input type="checkbox" id="a11y-high-contrast" />
      <span>High contrast</span>
    </label>

    <label class="a11y-option">
      <input type="checkbox" id="a11y-reduce-motion" />
      <span>Reduce motion</span>
    </label>

    <label class="a11y-option">
      <input type="checkbox" id="a11y-enhanced-focus" />
      <span>Enhanced focus</span>
    </label>

    <div class="a11y-scale">
      <label for="a11y-text-scale">Text size</label>
      <div class="a11y-scale-row">
        <input
          type="range"
          id="a11y-text-scale"
          min="0.875"
          max="1.25"
          step="0.125"
          value="1"
          aria-valuemin="0.875"
          aria-valuemax="1.25"
          aria-valuenow="1"
        />
        <output id="a11y-text-scale-out" for="a11y-text-scale">100%</output>
      </div>
    </div>
  </div>
</div>

<style>
.a11y-toolbar {
  position: relative;
  flex-shrink: 0;
  z-index: 1001;
}

.a11y-trigger {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: rgba(255, 255, 255, 0.9);
  border-radius: 6px;
  padding: 7px 10px;
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
}

.a11y-trigger:hover,
.a11y-trigger[aria-expanded="true"] {
  background: rgba(255, 255, 255, 0.18);
  border-color: var(--gold);
  color: #fff;
}

.a11y-trigger-label {
  display: none;
}

.a11y-panel {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  width: min(260px, calc(100vw - 32px));
  background: var(--card-dark);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 8px;
  padding: 14px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  z-index: 1100;
}

.a11y-panel-title {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
}

.a11y-option {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 8px;
  cursor: pointer;
}

.a11y-option input {
  width: 16px;
  height: 16px;
  accent-color: var(--gold);
}

.a11y-scale label {
  display: block;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 6px;
}

.a11y-scale-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.a11y-scale-row input[type="range"] {
  flex: 1;
  accent-color: var(--gold);
}

.a11y-scale-row output {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 600;
  color: var(--gold);
  min-width: 42px;
  text-align: right;
}

@media (max-width: 768px) {
  .a11y-toolbar {
    display: none;
  }
}
</style>

<script>
const STORAGE = {
  highContrast: 'high-contrast',
  textScale: 'text-scale',
  reduceMotion: 'reduce-motion',
  keyboardNavigation: 'keyboard-navigation',
};

const root = document.documentElement;

function readBool(key) {
  try {
    return localStorage.getItem(key) === 'true';
  } catch {
    return false;
  }
}

function writeBool(key, on) {
  try {
    if (on) localStorage.setItem(key, 'true');
    else localStorage.removeItem(key);
  } catch {
    /* ignore */
  }
}

function readScale() {
  try {
    const raw = localStorage.getItem(STORAGE.textScale);
    const n = raw ? parseFloat(raw) : 1;
    if (Number.isFinite(n) && n >= 0.875 && n <= 1.25) return n;
  } catch {
    /* ignore */
  }
  return 1;
}

function writeScale(value) {
  try {
    localStorage.setItem(STORAGE.textScale, String(value));
  } catch {
    /* ignore */
  }
}

function applyHighContrast(on) {
  root.classList.toggle('high-contrast', on);
  writeBool(STORAGE.highContrast, on);
}

function applyReduceMotion(on) {
  root.classList.toggle('reduce-motion', on);
  writeBool(STORAGE.reduceMotion, on);
}

function applyEnhancedFocus(on) {
  root.classList.toggle('enhanced-focus', on);
  writeBool(STORAGE.keyboardNavigation, on);
}

function applyTextScale(value) {
  root.style.setProperty('--text-scale', String(value));
  writeScale(value);
}

function formatScale(value) {
  return `${Math.round(value * 100)}%`;
}

const trigger = document.getElementById('a11y-trigger');
const panel = document.getElementById('a11y-panel');
const highContrast = document.getElementById('a11y-high-contrast');
const reduceMotion = document.getElementById('a11y-reduce-motion');
const enhancedFocus = document.getElementById('a11y-enhanced-focus');
const textScale = document.getElementById('a11y-text-scale');
const textScaleOut = document.getElementById('a11y-text-scale-out');

if (
  trigger instanceof HTMLButtonElement &&
  panel instanceof HTMLElement &&
  highContrast instanceof HTMLInputElement &&
  reduceMotion instanceof HTMLInputElement &&
  enhancedFocus instanceof HTMLInputElement &&
  textScale instanceof HTMLInputElement &&
  textScaleOut instanceof HTMLOutputElement
) {
  const initialScale = readScale();
  highContrast.checked = readBool(STORAGE.highContrast);
  reduceMotion.checked = readBool(STORAGE.reduceMotion);
  enhancedFocus.checked = readBool(STORAGE.keyboardNavigation);
  textScale.value = String(initialScale);
  textScale.setAttribute('aria-valuenow', String(initialScale));
  textScaleOut.textContent = formatScale(initialScale);

  function closePanel() {
    panel.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  }

  function openPanel() {
    panel.hidden = false;
    trigger.setAttribute('aria-expanded', 'true');
  }

  trigger.addEventListener('click', () => {
    if (panel.hidden) openPanel();
    else closePanel();
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!panel.hidden && !panel.contains(target) && !trigger.contains(target)) {
      closePanel();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !panel.hidden) closePanel();
  });

  highContrast.addEventListener('change', () => applyHighContrast(highContrast.checked));
  reduceMotion.addEventListener('change', () => applyReduceMotion(reduceMotion.checked));
  enhancedFocus.addEventListener('change', () => applyEnhancedFocus(enhancedFocus.checked));

  textScale.addEventListener('input', () => {
    const value = parseFloat(textScale.value);
    applyTextScale(value);
    textScale.setAttribute('aria-valuenow', String(value));
    textScaleOut.textContent = formatScale(value);
  });
}
</script>
