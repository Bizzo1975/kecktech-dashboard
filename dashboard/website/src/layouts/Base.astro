---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/accessibility.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Kecktech IT Solutions — Reliable IT support for small businesses and seniors in Park City, Kansas. Human-first, privacy-focused, built to last.',
  ogImage = '/brand/colored-logo.png',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://www.kecktech.net');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Kecktech IT Solutions</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | Kecktech IT Solutions`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/brand/transparent-logo.png" />

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Apply saved a11y prefs before paint (WWFL-compatible keys) -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      try {
        if (localStorage.getItem('high-contrast') === 'true') d.classList.add('high-contrast');
        if (localStorage.getItem('reduce-motion') === 'true') d.classList.add('reduce-motion');
        if (localStorage.getItem('keyboard-navigation') === 'true') d.classList.add('enhanced-focus');
        var s = localStorage.getItem('text-scale');
        if (s) {
          var n = parseFloat(s);
          if (n >= 0.875 && n <= 1.25) d.style.setProperty('--text-scale', String(n));
        }
      } catch (e) { /* private mode */ }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
.skip-link {
  position: absolute;
  top: -100px;
  left: 16px;
  background: var(--gold);
  color: #fff;
  padding: 10px 16px;
  border-radius: 0 0 6px 6px;
  font-family: var(--font-heading);
  font-weight: 600;
  z-index: 9999;
  text-decoration: none;
  transition: top 0.2s;
}
.skip-link:focus { top: 0; }
</style>
