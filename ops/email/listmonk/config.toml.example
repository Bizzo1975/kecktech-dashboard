[app]
address = "0.0.0.0:9000"
admin_username = "admin"
# Override via env file on host — change after first login
admin_password = "CHANGE_ME_ON_FIRST_LOGIN"

[db]
host = "listmonk-db"
port = 5432
user = "listmonk"
password = "CHANGE_ME_DB"
database = "listmonk"
ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

[app.check_updates]
enabled = false
