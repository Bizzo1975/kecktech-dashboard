{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kecktech.net/schemas/recovery-issues.schema.json",
  "title": "Kecktech recovery issues",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "priority", "status", "scope", "observedState",
        "evidence", "requiredAction", "acceptanceCriteria", "approvalGate",
        "rollback", "notionSync"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^KT-[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["blocked", "ready", "in_progress", "in_review", "verified", "intentionally_disabled"] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["services", "repositories", "hosts"],
          "properties": {
            "services": { "type": "array", "items": { "type": "string" } },
            "repositories": { "type": "array", "items": { "type": "string" } },
            "hosts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "observedState": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observedAt", "source", "summary"],
            "properties": {
              "observedAt": { "type": "string", "format": "date-time" },
              "source": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        },
        "requiredAction": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "approvalGate": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "externalGate": { "type": ["string", "null"] },
        "notionSync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "state"],
          "properties": {
            "page": { "type": "string", "format": "uri" },
            "state": { "enum": ["current", "pending", "conflict"] }
          }
        }
      }
    }
  }
}

