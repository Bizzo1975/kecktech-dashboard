# Unified Assistant deployment template
# Evidence status: LOCALLY VERIFIED — NOT DEPLOYED
# Empty required values intentionally fail closed. Never commit populated secrets.

NEXUS_ASSISTANT_BIND_HOST=127.0.0.1
NEXUS_ASSISTANT_PORT=8787
NEXUS_ASSISTANT_OPERATOR_TOKEN=
NEXUS_ASSISTANT_DATA_DIR=/var/lib/nexus-assistant
NEXUS_ASSISTANT_CLOUD_ALLOWED=0
NEXUS_ASSISTANT_APPROVAL_TTL_MINUTES=15

SOVEREIGN_ASSISTANT_URL=
SOVEREIGN_ASSISTANT_READ_KEY=
SOVEREIGN_ASSISTANT_WRITE_KEY=
LIT_ASSISTANT_URL=
LIT_ASSISTANT_READ_KEY=
LIT_ASSISTANT_WRITE_KEY=

GPU_BROKER_URL=
GPU_BROKER_API_KEY=
NEXUS_ASSISTANT_GPU_APP_ID=nexus-assistant
NEXUS_ASSISTANT_GPU_JOB_CLASS=llm
NEXUS_ASSISTANT_GPU_PRIORITY=70
NEXUS_ASSISTANT_GPU_TIMEOUT_MS=60000
NEXUS_ASSISTANT_GPU_MAX_RETRIES=1
NEXUS_ASSISTANT_GPU_MAX_INPUT_TOKENS=12000
NEXUS_ASSISTANT_GPU_MAX_OUTPUT_TOKENS=2000
NEXUS_ASSISTANT_GPU_MAX_VRAM_MB=22000
NEXUS_ASSISTANT_MIN_FREE_DISK_GB=100
NEXUS_ASSISTANT_MODEL_DOWNLOADS_ENABLED=0
NEXUS_ASSISTANT_MODEL_ALLOWLIST=

# Semicolon-delimited, canonicalized allowlist. Paths outside this set are rejected.
NEXUS_ASSISTANT_REPO_ROOTS=F:\Github\kecktech-infrastructure;F:\Github\kecktech-dashboard;F:\Github\nexus;F:\Github\gpu-broker;F:\Github\Huxley;F:\Github\sovereign-standalone
